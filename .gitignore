*.profdata
a.out
core
core.[0-9]*

# Example executables have no extension. Keep example sources and documentation.
/examples/**
!/examples/**/
!/examples/**/*.c
!/examples/**/*.h
!/examples/**/*.md
!/examples/**/Makefile
!/examples/**/.gitignore

# Local clone of the book's separately versioned upstream test suite.
# https://github.com/nlsandler/writing-a-c-compiler-tests
/writing-a-c-compiler-tests/

# Tool caches and Python artifacts from the book's test runner
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local environment files (keep shareable examples/templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local
*.log

