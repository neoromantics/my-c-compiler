# Compiler executables and build directories
/mycc
/my-c-compiler
/bin/
/build/
/dist/
/out/
/tmp/
/temp/
.mycc-*/

# Go build/test artifacts and local workspace configuration
*.exe
*.exe~
*.test
*.out
*.prof
*.pprof
*.coverprofile
/coverage/
/coverage.*
/cover.out
/cover.html
/go.work
/go.work.sum

# C preprocessing, assembly, linking, and debugging artifacts
*.i
*.ii
*.s
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.d
*.dSYM/
*.pdb
*.ilk
